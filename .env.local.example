# ─── Required ────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/<db>
NEXTAUTH_SECRET=your-secret-here
NEXTAUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ─── Supplier Risk Intelligence (all free tier) ───────────────────────────────
# These are OPTIONAL — the platform works without them.
# The following unlock additional intelligence sources.

# News API — 100 requests/day free
# Sign up: https://newsapi.org/register
NEWS_API_KEY=

# OpenSanctions — 10,000 requests/month free
# Sign up: https://www.opensanctions.org/api/
OPENSANCTIONS_API_KEY=

# Alpha Vantage — 500 requests/day free (financial news sentiment)
# Sign up: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_KEY=

# ─── Already free, no key needed ─────────────────────────────────────────────
# World Bank API         — https://datahelpdesk.worldbank.org/knowledgebase/articles/898581
# GDELT Global News      — https://blog.gdeltproject.org/gdelt-doc-2-0-api-debuts/
# REST Countries         — https://restcountries.com/
# OpenCorporates         — https://opencorporates.com/info/api
# SEC EDGAR (US filings) — https://efts.sec.gov/
# Yahoo Finance          — via yahoo-finance2 npm package (no key needed)
# ExchangeRate-API       — https://open.er-api.com/v6/latest/USD
